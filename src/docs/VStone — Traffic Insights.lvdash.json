{
  "datasets": [
    {
      "name": "08299ece",
      "displayName": "Top 10 Streets Trend",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    t.month_year,\r\n    t.street_name,\r\n    t.avg_pollution,\r\n    t.avg_noise,\r\n    t.reading_count\r\nFROM vstone_catalog.gold.agg_monthly_street_trend t\r\nJOIN (\r\n    SELECT street_id\r\n    FROM vstone_catalog.gold.agg_top10_streets_by_pollution\r\n) top\r\nON t.street_id = top.street_id\r\nORDER BY t.month_year, t.avg_pollution DESC",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "2fc57365",
      "displayName": "Top 10 Pollution Leaderboard",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    street_name,\r\n    avg_pollution,\r\n    avg_noise,\r\n    reading_count\r\nFROM vstone_catalog.gold.agg_top10_streets_by_pollution\r\nORDER BY avg_pollution DESC",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "1eabb885",
      "displayName": "Traffic by Sensor Node",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    location,\r\n    latitude,\r\n    longitude,\r\n    SUM(total_enter) AS total_enter,\r\n    SUM(total_exit) AS total_exit,\r\n    ROUND(AVG(total_enter + total_exit), 1) AS avg_daily_volume\r\nFROM vstone_catalog.gold.agg_traffic_by_location_daily\r\nGROUP BY\r\n    location,\r\n    latitude,\r\n    longitude\r\nORDER BY avg_daily_volume DESC",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "de0f5993",
      "displayName": "Traffic Volume Trend",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    reading_date,\r\n    SUM(total_enter) AS total_enter,\r\n    SUM(total_exit) AS total_exit\r\nFROM vstone_catalog.gold.agg_traffic_by_location_daily\r\nGROUP BY reading_date\r\nORDER BY reading_date",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "dd3fe931",
      "displayName": "Create the Street Activity dataset",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    churn_status,\r\n    COUNT(*) AS street_count,\r\n    ROUND(AVG(total_reports), 1) AS avg_reports\r\nFROM vstone_catalog.gold.agg_stale_streets\r\nGROUP BY churn_status\r\nORDER BY street_count DESC",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "59c1d24b",
      "displayName": "Citizen Reports by Street",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n    month_year,\r\n    street_name,\r\n    report_count\r\nFROM vstone_catalog.gold.agg_citizen_reports_by_street\r\nORDER BY month_year, report_count DESC",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "0a303ec3",
      "displayName": "dim_street",
      "config": {
        "version": "1.1",
        "source": "vstone_catalog.gold.dim_street",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "a76ad99b",
      "displayName": "Street Count",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(*) AS street_count\r\n",
        "FROM vstone_catalog.gold.dim_street\r\n",
        "WHERE __END_AT IS NULL"
      ],
      "catalog": "vstone_catalog",
      "schema": "gold"
    }
  ],
